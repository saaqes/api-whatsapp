# ═══════════════════════════════════════════════════════════════════════
#  Configuración del asistente de WhatsApp con IA
#  Copia este archivo como ".env" (o ejecuta: npm run setup) y complétalo.
#  ¡NUNCA subas el archivo .env a GitHub! Ya está en .gitignore.
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
# URL pública del servidor (en Render: https://tu-app.onrender.com). Se usa para mostrar la URL del webhook.
PUBLIC_URL=

# ─── Base de datos PostgreSQL ───
# Local con Docker:  postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_ai
# Neon / Render:     pega aquí la "connection string" que te da el proveedor
DATABASE_URL=postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_ai

# ─── Seguridad (npm run setup los genera automáticamente) ───
ENCRYPTION_KEY=
SESSION_SECRET=

# ─── Primer usuario del panel (se crea al arrancar si no existe ninguno) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ─── Claude (Anthropic) — https://console.anthropic.com/settings/keys ───
# También puedes configurarla desde el panel (Sistema → Conexiones).
ANTHROPIC_API_KEY=
# Solo para probar el panel sin API Key: respuestas simuladas (NO es IA real).
CLAUDE_MOCK=false

# ─── WhatsApp Cloud API (Meta) — https://developers.facebook.com/apps ───
# También configurables desde el panel. Ver docs/INSTALACION.md, pasos 5 a 10.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Inventa una frase secreta y escribe la MISMA en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# "simulation" = no envía nada a WhatsApp (pruebas). "live" = envía mensajes reales.
WHATSAPP_MODE=simulation

# ─── Transcripción de audios (opcional, servicio externo con costo) ───
TRANSCRIPTION_API_KEY=

LOG_LEVEL=info
